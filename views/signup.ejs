<%- include('partials/header') %>

<section class="auth-section">
  <div class="auth-card glass-card">
    <h2>Sign Up</h2>
    <p class="auth-subtitle">Create your account and start posting places.</p>
    <form action="/signup" method="POST">
      <div class="form-group">
        <label for="username">Your Name</label>
        <input type="text" id="username" name="username" placeholder="John Doe" required>
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="At least 4 characters" required minlength="4">
      </div>
      <div class="form-group">
        <label for="password2">Confirm Password</label>
        <input type="password" id="password2" name="password2" placeholder="Type password again" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Create Account</button>
    </form>
    <p class="auth-footer">Already have an account? <a href="/login">Log in</a></p>
  </div>
</section>

<%- include('partials/footer') %>
